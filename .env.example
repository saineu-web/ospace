# Copy to .env and fill in. Nothing here is required for local development.
SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,ospacegroup.com,www.ospacegroup.com
SITE_URL=https://www.ospacegroup.com
# DATABASE_URL=postgres://user:pass@host:5432/ospace   (omit to use SQLite)
# MEDIA_ROOT=/srv/ospace/media
# SQLITE_PATH=/srv/ospace/data/db.sqlite3   (keep the DB outside the app dir on a server)

# Outgoing mail. With EMAIL_HOST empty, mail is printed to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Ospace <info@ospacegroup.com>
# Every website submission (driver applications, ride requests, contact messages) goes here.
# CONTACT_INBOX defaults to the same address; set it only to split ride/contact mail elsewhere.
ONBOARDING_INBOX=onboarding@ospacegroup.com

# Optional
SENTRY_DSN=
PULSE_TOKEN=
