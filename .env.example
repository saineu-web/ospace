# Copy to .env and fill in. Nothing here is required for local development.
SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,ospacegroup.com,www.ospacegroup.com
SITE_URL=https://www.ospacegroup.com
# DATABASE_URL=postgres://user:pass@host:5432/ospace   (omit to use SQLite)
# MEDIA_ROOT=/srv/ospace/media

# Outgoing mail. With EMAIL_HOST empty, mail is printed to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Ospace <info@ospacegroup.com>
# Where website forms (apply / contact / ride request) are delivered
CONTACT_INBOX=info@ospacegroup.com

# Optional
SENTRY_DSN=
PULSE_TOKEN=
